    "NSAppleMusicUsageDescription" : {
      "comment" : "Info.plist NSAppleMusicUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ermöglicht dir, die aktuelle Musikwiedergabe in der App zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This allows you to control current music playback in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto te permite controlar la reproducción de música actual en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela vous permet de contrôler la lecture de musique en cours dans l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appで現在再生中のミュージックを操作できるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许您在此 App 中控制当前的音乐播放。"
          }
        }
      }
    },
    "NSHomeKitUsageDescription" : {
      "comment" : "Info.plist NSHomeKitUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ermöglicht dir, Farben mit den Lichtern deines Zuhauses zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This allows you to sync colors with home lights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto te permite sincronizar los colores con las luces del hogar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela vous permet de synchroniser les couleurs avec les lumières de la maison."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "色をホームのライトと同期できるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许您将颜色与家庭灯光同步。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist NSLocalNetworkUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ermöglicht dir, den UI-Stil mit Geräten in der Nähe zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This allows you to sync UI style with nearby devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto te permite sincronizar el estilo de la interfaz con los dispositivos cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela vous permet de synchroniser le style de l'interface avec les appareils à proximité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "UIのスタイルを近くのデバイスと同期できるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许您将 UI 样式与附近的设备同步。"
          }
        }
      }
    },
    "NSNearbyInteractionUsageDescription" : {
      "comment" : "Info.plist NSNearbyInteractionUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ermöglicht dir, die Perspektive eines Weltraumfensters an die Position deines Geräts anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This allows you to match a space window's perspective to your device's position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esto te permite ajustar la perspectiva de una ventana espacial según la posición de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cela vous permet d'ajuster la perspective d'une fenêtre spatiale à la position de votre appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "デバイスの位置に合わせてスペースウィンドウの視点を一致させることができるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "允许您根据设备的位置匹配太空窗口的视角。"
          }
        }
      }
    }
  },
  "version" : "1.0"
