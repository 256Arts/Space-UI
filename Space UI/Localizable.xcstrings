    "Tap the last icon at the bottom of the lock screen for settings, and modify the seed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippe auf das letzte Symbol unten auf dem Sperrbildschirm, um die Einstellungen zu öffnen und den Startwert zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca el último ícono en la parte inferior de la pantalla de bloqueo para abrir los ajustes y modificar la semilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touchez la dernière icône en bas de l'écran verrouillé pour ouvrir les réglages et modifier la graine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ロック画面下部の最後のアイコンをタップして設定を開き、シードを変更します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "点按锁定屏幕底部的最后一个图标以打开设置，并修改种子。"
          }
        }
      }
    },
    "Tell this screen which edges another screen sits against, so the frame joins up." : {
