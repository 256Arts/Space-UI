    "Bias the generated theme instead of leaving it fully random." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Das generierte Design beeinflussen, statt es vollständig zufällig zu lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sesgar el tema generado en lugar de dejarlo totalmente aleatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orienter le thème généré au lieu de le laisser entièrement aléatoire."
